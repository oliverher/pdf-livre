# Copie este arquivo para .env e preencha os valores reais.
# NUNCA cole a chave real em um chat, issue ou commit — .env está no
# .gitignore de propósito.

# --- IA de visao (opcional) ------------------------------------------------
# Sem esta chave, o app funciona normalmente no modo convencional
# (OpenCV + Tesseract), sem custo. Com ela, a rota "visao" passa a usar
# o modelo Claude para analisar a composicao das paginas (RF11/RF12).
ANTHROPIC_API_KEY=

# Teto de gasto diario em dolares para a IA de visao. Se o gasto do dia
# atingir este valor, o app volta automaticamente ao modo convencional.
PPTLIVRE_TETO_DIARIO_USD=5.0

# Modelo usado na analise de visao.
PPTLIVRE_VISION_MODEL=claude-opus-4-8

# --- Limites gerais ---------------------------------------------------------
PPTLIVRE_MAX_MB=60

# --- Supabase (integracao futura: historico + storage) ---------------------
# URL e chave do projeto "PDF Livre" (ver painel do Supabase > Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
